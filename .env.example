# Copy this file to .env and edit values for your local environment.
#
# Docker Compose automatically reads .env from the repository root and uses
# these values in docker-compose.yml.

# Dashboard -> Control Server URL.
# For Docker Compose, keep the service URL below.
# For host-local scripts, use http://localhost:8000 in the script environment.
PROBE_SERVER_URL=http://control-server:8000

# Optional legacy API keys accepted by Control Server.
# Leave empty to run without auth unless admin users already exist.
# Multiple keys can be comma-separated.
CONTROL_API_KEYS=dev-secret-key

# When true, Control Server refuses to start if authentication cannot be
# enabled (no admin user bootstrapped and CONTROL_API_KEYS empty), instead of
# silently running open. Local dev default is false (unset). Production
# (docker-compose.prod.yml) sets this to "true"; see docs/deployment-https.md
# 公開前チェック.
CONTROL_REQUIRE_AUTH=false

# Dashboard API key sent as X-Api-Key to Control Server.
# For simple local development, set this to the same value as CONTROL_API_KEYS.
DASHBOARD_API_KEY=dev-secret-key

# Set true when the Dashboard is served over HTTPS.
DASHBOARD_COOKIE_SECURE=false

# URL shown to SDK users in the Dashboard's Connect SDK tab.
# In Docker Compose, PROBE_SERVER_URL points to the internal service name, but
# host-local clients usually need http://localhost:8000.
PROBE_CLIENT_SERVER_URL=http://localhost:8000
# Production HTTPS example (docker-compose.prod.yml, see docs/deployment-https.md):
# PROBE_CLIENT_SERVER_URL=https://probe.example.com/api

# Public FQDN Caddy serves over HTTPS in docker-compose.prod.yml.
# Only used by docker-compose.prod.yml / deploy/caddy/Caddyfile; ignored by
# the local docker-compose.yml. DNS A record must point to the VM's static
# external IPv4 before startup so Caddy's Automatic HTTPS can issue a
# certificate. See docs/deployment-https.md.
PUBLIC_HOST=probe.example.com

# SDK install target shown in the Dashboard's Connect SDK tab.
PROBE_SDK_INSTALL_URL=git+https://github.com/dx-junkyard/probe-agent.git@main#subdirectory=packages/python-probe

# Optional bootstrap admin user. On first startup, Control Server creates this
# user if it does not already exist.
CONTROL_ADMIN_USERNAME=admin
CONTROL_ADMIN_PASSWORD=change-me

# LLM used by Generate & Evaluate.
# Supported providers: openai, anthropic, gemini, mock.
# Set LLM_PROVIDER=mock only for local smoke tests; it does not call an external LLM.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=120

# Feature Intelligence の自由度のある推論には reasoning model が必須。
# 未設定・API failure 時に heuristic へ fallback しない。
# INTELLIGENCE_LLM_PROVIDER / INTELLIGENCE_LLM_MODEL が空の場合は
# LLM_PROVIDER / LLM_MODEL に fallback する。provider と model family の不整合は
# Dashboard の System Settings Diagnostics (GET /system-diagnostics) が検出する。
INTELLIGENCE_LLM_PROVIDER=
INTELLIGENCE_LLM_MODEL=gpt-5.4
INTELLIGENCE_LLM_TIMEOUT=120
INTELLIGENCE_ALLOW_HEURISTIC_FALLBACK=false
# GPT-5.4 mini / GPT-5.4の最大出力token数。Repository Draft生成に使用する。
INTELLIGENCE_MAX_OUTPUT_TOKENS=128000

# Host側のRepository群を配置した絶対パス。
# ユーザー名や案件名を含み得るため、実値はGitへcommitしないこと。
# 通常の解析はcommitted filesだけを読み、承認済みProbe PatchのApply時だけ
# このmountへ書き込む。
PROBE_REPOSITORY_HOST_ROOT=/absolute/path/to/repositories

# Repository Snapshot content storage and Decision Workspace LLM-context
# budgets are independent. Oversized/unsupported files remain visible as
# metadata-only snapshot entries and do not make snapshot creation fail.
SNAPSHOT_MAX_FILE_SIZE=524288
WORKSPACE_CONTEXT_MAX_CATEGORY_CHARS=12000
WORKSPACE_CONTEXT_MAX_CHARS=50000

# GitHub App used by the publish workflow (Issue #216) to broker short-lived
# Installation Access Tokens for cloning/fetching and, after explicit human
# approval, pushing a probe/ branch and opening a Pull Request. The private
# key is a PEM file mounted as a secret, never committed. Leave both unset to
# keep the GitHub App publish workflow disabled (fails closed).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app-private-key.pem
# The login of the single Organization that owns this private GitHub App.
# Administrators can register only installations whose GitHub account is this
# Organization, then explicitly assign them to individual Systems.
GITHUB_APP_ALLOWED_ORGANIZATION=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com

# Repository manager (Issue #216 sub-task 2): server-managed clone/fetch/
# worktree area used by the publish workflow. A non-bare mirror per GitHub
# connection lives under {GIT_REPOSITORY_ROOT}/mirrors/{connection_id}, and
# per-job pinned-SHA worktrees under {GIT_REPOSITORY_ROOT}/jobs/{job_id}.
# Leave unset to keep the repository manager disabled (fails closed).
# docker-compose.yml/docker-compose.prod.yml set this directly to a fixed
# in-container path on the probe-data volume (/data/git-repositories), the
# same way PROBE_REPOSITORY_ROOTS is fixed to /repositories; this entry is
# for running Control Server outside Docker Compose.
GIT_REPOSITORY_ROOT=
GIT_CLONE_TIMEOUT=300
GIT_FETCH_TIMEOUT=120
GIT_JOB_RETENTION_HOURS=24

# Publish job state machine (Issue #216 sub-task 3): commit/push/PR creation
# for an approved probe patch, gated by explicit human approval
# (`POST /github/publish-jobs/{id}/approve`). The pushed branch is always
# server-generated (`{GIT_BRANCH_PREFIX}job-{job_id}-{base_commit_sha[:8]}`);
# GIT_ALLOW_DIRECT_PUSH / GIT_ALLOW_FORCE_PUSH are read but any value other
# than "false" fails the job closed -- direct/force push are not
# implemented in this MVP (Principle 5/8). GIT_ALLOW_WORKFLOW_CHANGES
# controls only whether `.github/workflows/` files in a patch diff may be
# staged; leave it false unless you understand the CI implications.
GIT_BRANCH_PREFIX=probe/
GIT_ALLOW_DIRECT_PUSH=false
GIT_ALLOW_FORCE_PUSH=false
GIT_ALLOW_WORKFLOW_CHANGES=false
GITHUB_APP_BOT_NAME=probe-agent[bot]
GITHUB_APP_BOT_EMAIL=probe-agent[bot]@users.noreply.github.com
